  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 98b8b2d164b80f54aa8ee83f978f9f1c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem
  text: {fileID: 23880691}
  lines:
  - "Me dijiste que en ese momento quer\xEDas que te besara."
  - Y yo todo nervioso y tonto...
  - "Ese d\xEDa empez\xF3 todo..."
  - "Al siguiente fue el primer d\xEDa de pasarnoslo genial, el primero de todos..."
  - Pero esta historia solo acaba de empezar.
  - "Y quiero que tengas esta peque\xF1a experiencia como recordatorio de que te
    quiero y te querr\xE9 para siempre."
  - Espero que te haya gustado esta tontada...
  - FIN
  - (fin del juego, no de nuestro amor incondicional e infinito jeje)
  - TE QUIERO
  textSpeed: 0.1
  panel: {fileID: 1925215439}
  endPanel: {fileID: 768707760}
  activate: 0
